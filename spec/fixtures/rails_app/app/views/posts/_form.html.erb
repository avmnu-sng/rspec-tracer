<%= form_with model: post, local: true do |f| %>
  <% if post.errors.any? %>
    <div class="errors">
      <h2><%= t('posts.form.errors', count: post.errors.count) %></h2>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :user_id %>
    <%= f.collection_select :user_id, User.order(:name), :id, :display_name %>
  </div>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= f.label :body %>
    <%= f.rich_text_area :body %>
  </div>

  <div class="field">
    <%= f.label :category_ids %>
    <%= f.collection_check_boxes :category_ids, Category.alphabetical, :id, :name %>
  </div>

  <%= f.submit %>
<% end %>
