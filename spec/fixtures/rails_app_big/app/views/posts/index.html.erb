<% content_for :title, t('.title') %>

<h1><%= t('.title') %></h1>

<nav class="filters">
  <%= link_to t('.all'), posts_path %>
  <%= link_to t('.drafts'), posts_path(drafts: '1') %>
  <%= link_to t('.new'), new_post_path, class: 'button primary' %>
</nav>

<section class="posts">
  <% if @posts.any? %>
    <%= render @posts %>
  <% else %>
    <p class="empty"><%= t('.empty') %></p>
  <% end %>
</section>
