<% content_for :title, @post.title %>

<article class="post">
  <h1><%= @post.title %></h1>
  <p class="meta">
    <%= t('posts.by', author: @post.user.display_name) %>
    <% if @post.published? %>
      <span class="published-at"><%= l(@post.published_at, format: :long) %></span>
    <% end %>
  </p>
  <div class="body">
    <%= @post.body %>
  </div>
  <div class="categories">
    <% @post.categories.each do |category| %>
      <%= link_to category.name, category_path(category), class: 'category-tag' %>
    <% end %>
  </div>
</article>

<section class="comments">
  <h2><%= t('posts.comments_count', count: @post.comment_count) %></h2>
  <%= link_to t('.view_comments'), post_comments_path(@post) %>
</section>

<nav class="actions">
  <%= link_to t('.edit'), edit_post_path(@post), class: 'button' %>
  <% unless @post.published? %>
    <%= button_to t('.publish'), publish_post_path(@post), method: :post, class: 'button primary' %>
  <% end %>
  <%= button_to t('.destroy'), post_path(@post),
                method: :delete,
                data: { confirm: t('.destroy_confirm') },
                class: 'button danger' %>
</nav>
