<article class="post <%= post.published? ? 'published' : 'draft' %>" id="<%= dom_id(post) %>">
  <h2><%= link_to post.title, post_path(post) %></h2>
  <p class="meta">
    <%= t('posts.by', author: post.user.display_name) %>
    <% if post.published? %>
      <span class="published-at"><%= l(post.published_at, format: :short) %></span>
    <% else %>
      <span class="draft-badge"><%= t('posts.draft') %></span>
    <% end %>
  </p>
  <p class="comments-count"><%= t('posts.comments_count', count: post.comment_count) %></p>
</article>
