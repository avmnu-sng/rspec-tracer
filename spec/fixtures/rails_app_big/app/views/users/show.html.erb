<% content_for :title, @user.display_name %>

<%= render @user %>

<section class="posts">
  <h2><%= t('.posts_by', name: @user.display_name) %></h2>
  <% if @posts.any? %>
    <ul>
      <% @posts.each do |post| %>
        <li><%= link_to post.title, post_path(post) %></li>
      <% end %>
    </ul>
  <% else %>
    <p><%= t('.no_posts') %></p>
  <% end %>
</section>

<nav class="actions">
  <%= link_to t('.edit'), edit_user_path(@user), class: 'button' %>
  <%= button_to t('.destroy'), user_path(@user),
                method: :delete,
                data: { confirm: t('.destroy_confirm') },
                class: 'button danger' %>
</nav>
