<h1>New comment on &ldquo;<%= @post.title %>&rdquo;</h1>

<p>Hi <%= @author.display_name %>,</p>

<p><strong><%= @comment.user.display_name %></strong> left a comment on your post:</p>

<blockquote>
  <%= simple_format(@comment.body) %>
</blockquote>

<p>
  <%= link_to 'View post', post_url(@post) %>
</p>

<p>— The Rails App team</p>
